<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="system">
        <comment>Baseline - Initial database setup</comment>

        <!-- Using empty changeset for baseline - you can add tables here as needed -->
        <sql>SELECT 1</sql>

        <!-- Example of how to add tables:
        <createTable tableName="example_table">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        -->
    </changeSet>

    <!-- Tag the database after the changeset -->
    <changeSet id="2" author="system">
        <tagDatabase tag="v1.0.0-baseline"/>
    </changeSet>

</databaseChangeLog>
