		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login - Admin Success",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Status code is 200",
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Test 2: Response time is acceptable",
									"pm.test(\"Response time is less than 2000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);",
									"});",
									"",
									"// Test 3: Response has required fields",
									"pm.test(\"Response contains token and user data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('token');",
									"    pm.expect(jsonData).to.have.property('type');",
									"    pm.expect(jsonData).to.have.property('userId');",
									"    pm.expect(jsonData).to.have.property('email');",
									"    pm.expect(jsonData).to.have.property('roles');",
									"});",
									"",
									"// Test 4: Token format validation",
									"pm.test(\"Token type is Bearer\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.type).to.eql('Bearer');",
									"});",
									"",
									"// Test 5: JWT token format",
									"pm.test(\"Token is valid JWT format\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.token).to.match(/^[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+$/);",
									"});",
									"",
									"// Test 6: User role validation",
									"pm.test(\"Admin has SUPER_ADMIN role\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.roles).to.include('SUPER_ADMIN');",
									"});",
									"",
									"// Test 7: Email validation",
									"pm.test(\"Email matches request\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.email).to.eql('admin@tasktracker.com');",
									"});",
									"",
									"// Test 8: Organization data present",
									"pm.test(\"Organization data is present\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('organizationId');",
									"    pm.expect(jsonData).to.have.property('organizationName');",
									"});",
									"",
									"// Save token for subsequent requests",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('admin_token', jsonData.token);",
									"    pm.environment.set('admin_userId', jsonData.userId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@tasktracker.com\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Test successful admin login with valid credentials"
					},
					"response": []
				},
